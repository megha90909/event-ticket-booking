# Server port (Render injects PORT automatically in production)
PORT=5000

# MongoDB connection string:
# - Local development: keep your local MongoDB or existing cluster0 URI
# - Production (Render + Atlas cluster0): specify the separate "event-booking" database
#   e.g. mongodb+srv://<prod_username>:<prod_password>@<cluster0-host>/event-booking?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/event-booking

# Secret key used to sign and verify JWT tokens (use a long random string in production)
JWT_SECRET=replace_with_a_long_random_secret

# Token expiration duration (e.g., 1d, 7d, 30d)
JWT_EXPIRES_IN=7d

# Comma-separated allowed frontend origin(s) for CORS (no trailing slash)
# Example in production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173
