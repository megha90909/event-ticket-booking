# Server port
PORT=5000

# MongoDB connection string (local MongoDB or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/event-booking

# Secret key used to sign and verify JWT tokens (use a long random string in production)
JWT_SECRET=replace_with_a_long_random_secret

# Token expiration duration (e.g., 1d, 7d, 30d)
JWT_EXPIRES_IN=7d

